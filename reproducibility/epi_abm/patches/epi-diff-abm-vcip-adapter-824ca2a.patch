+def _census_get(url, county_fips, label):
+    timeout_seconds = _env_int("EPI_CENSUS_TIMEOUT_SECONDS", 60)
+    retries = max(1, _env_int("EPI_CENSUS_RETRIES", 5))
+    retry_statuses = {429, 500, 502, 503, 504}
